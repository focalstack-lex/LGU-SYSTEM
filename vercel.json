{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/cv-builder",
      "dest": "client/cv-builder.html"
    },
    {
      "src": "/cv-verify",
      "dest": "client/cv-verify.html"
    },
    {
      "src": "/feedback/view",
      "dest": "client/feedback/view/index.html"
    },
    {
      "src": "/feedback",
      "dest": "client/feedback/index.html"
    },
    {
      "src": "/feedback/",
      "dest": "client/feedback/index.html"
    },
    {
      "src": "/faculty",
      "dest": "client/faculty.html"
    },
    {
      "src": "/(.*)",
      "dest": "client/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html"
    }
  ]
}
