{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://hchkfunaofyoualrdnkk.supabase.co https://lh3.googleusercontent.com https://api.qrserver.com; connect-src 'self' https://hchkfunaofyoualrdnkk.supabase.co wss://hchkfunaofyoualrdnkk.supabase.co https://api.coelgu-system.engineer https://api.iconify.design; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.js"
    },
    {
      "src": "/cv-builder",
      "dest": "client/cv-builder.html"
    },
    {
      "src": "/cv-verify",
      "dest": "client/cv-verify.html"
    },
    {
      "src": "/feedback/view",
      "dest": "client/feedback/view/index.html"
    },
    {
      "src": "/feedback",
      "dest": "client/feedback/index.html"
    },
    {
      "src": "/feedback/",
      "dest": "client/feedback/index.html"
    },
    {
      "src": "/faculty",
      "dest": "client/faculty.html"
    },
    {
      "src": "/(.*)",
      "dest": "client/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html"
    }
  ]
}
