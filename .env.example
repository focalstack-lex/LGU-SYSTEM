# =============================================================================
# Environment Configuration Template (.env.example)
# COE Budget System & Enrollment Transparency Portal
# =============================================================================

# Server Network & Runtime Configuration
PORT=3000
NODE_ENV=development
TRUST_PROXY=1
RENDER_EXTERNAL_URL=http://localhost:3000

# Supabase Backend Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Email Delivery (Brevo Transactional API)
BREVO_API_KEY=your-brevo-api-key-here

# Feature Gates & Allowlist Controls
# Comma-separated list of pilot student email accounts (Phase B/C rollout)
ENROLLMENT_PILOT_EMAILS=pilot.student1@g.cjc.edu.ph,pilot.student2@g.cjc.edu.ph

# Public Transparency Portal (Set to 'true' to enable unauthenticated aggregate metrics)
PUBLIC_TRANSPARENCY_MODE=false

# Forensic Audit Watchlists (Comma-separated watch targets)
FORENSIC_WATCH_EMAILS=target.audit1@g.cjc.edu.ph,target.audit2@g.cjc.edu.ph
FORENSIC_WATCH_IDS=00000000-0000-0000-0000-000000000000,11111111-1111-1111-1111-111111111111
